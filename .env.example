# Django configuration
DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# MySQL database configuration
DB_NAME=your_database_name
DB_USER=your_database_user
